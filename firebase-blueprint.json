{
    "entities": {
        "Task": {
            "title": "Task",
            "description": "User to-do task item",
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique identifier of the task"
                },
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "description": "Title or task summary"
                },
                "description": {
                    "type": "string",
                    "maxLength": 1000,
                    "description": "Detailed task description"
                },
                "completed": {
                    "type": "boolean",
                    "description": "Completion state of the task"
                },
                "priority": {
                    "type": "string",
                    "enum": [
                        "low",
                        "medium",
                        "high"
                    ],
                    "description": "Priority tier of the task"
                },
                "visibility": {
                    "type": "string",
                    "enum": [
                        "private",
                        "friends"
                    ],
                    "description": "Whether only the owner or connected friends can read the task"
                },
                "userId": {
                    "type": "string",
                    "description": "UID of the task owner"
                },
                "createdAt": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "ISO timestamp of creation"
                },
                "updatedAt": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "ISO timestamp of last modification"
                },
                "completedAt": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "ISO timestamp of completion"
                },
                "challengeId": {
                    "type": "string",
                    "maxLength": 128,
                    "description": "Optional collaborative challenge reference"
                }
            },
            "required": [
                "title",
                "completed",
                "userId",
                "createdAt",
                "visibility"
            ]
        },
        "UserProfile": {
            "title": "UserProfile",
            "description": "Basic profile information of the user",
            "type": "object",
            "properties": {
                "uid": {
                    "type": "string",
                    "description": "UID of the user"
                },
                "displayName": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "Display name of the user"
                },
                "email": {
                    "type": "string",
                    "maxLength": 150,
                    "description": "Email address of the user"
                },
                "photoURL": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "Avatar URL of the user"
                },
                "lastLoginAt": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Last sign-in timestamp"
                },
                "friendCode": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 8,
                    "description": "Shareable code used to connect with friends"
                },
                "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20,
                    "description": "Unique username used for friend requests"
                }
            },
            "required": [
                "uid",
                "email"
            ]
        },
        "Friend": {
            "title": "Friend",
            "description": "Mutual friend connection metadata",
            "type": "object",
            "properties": {
                "uid": {
                    "type": "string",
                    "description": "Friend's user ID"
                },
                "displayName": {
                    "type": "string",
                    "maxLength": 100
                },
                "email": {
                    "type": "string",
                    "maxLength": 150
                },
                "friendCode": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 8
                }
            },
            "required": [
                "uid",
                "displayName",
                "email",
                "friendCode"
            ]
        }
    },
    "firestore": {
        "/users/{userId}": {
            "schema": "UserProfile",
            "description": "User profile records accessible exclusively by the document owner"
        },
        "/users/{userId}/tasks/{taskId}": {
            "schema": "Task",
            "description": "Personal task records isolated to the authenticated user"
        },
        "/tasks/{taskId}": {
            "schema": "Task",
            "description": "Direct task documents isolated to the owner userId"
        },
        "/users/{userId}/friends/{friendId}": {
            "schema": "Friend",
            "description": "Mutual friend connection metadata"
        },
        "/users/{userId}/friendRequests/{requesterId}": {
            "description": "Pending username-based friend request"
        },
        "/usernames/{username}": {
            "description": "Unique username lookup record"
        },
        "/friendCodes/{code}": {
            "description": "Lookup record for a user's shareable friend code"
        },
        "/users/{userId}/tasks/{taskId}/reminders/{reminderId}": {
            "description": "Friend reminders attached to explicitly shared tasks"
        },
        "/challenges/{challengeId}": {
            "description": "Two-person collaborative challenge with per-user completion state"
        }
    }
}
